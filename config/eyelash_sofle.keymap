#define ZMK_POINTING_DEFAULT_MOVE_VAL 1200  // 600
#define ZMK_POINTING_DEFAULT_SCRL_VAL 25   // 10

#include <input/processors.dtsi>
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include <dt-bindings/zmk/rgb.h>

&mmv_input_listener { input-processors = <&zip_xy_scaler 2 1>; };

&msc_input_listener { input-processors = <&zip_scroll_scaler 2 1>; };

&msc {
    acceleration-exponent = <1>;      // 0
    time-to-max-speed-ms = <100>;       // 300
    delay-ms = <0>;                   // 0
};

&mmv {
    time-to-max-speed-ms = <500>;
    acceleration-exponent = <1>;
    trigger-period-ms = <16>;
};

&soft_off { hold-time-ms = <2000>; };

/ {
    scroll_encoder: scroll_encoder {
        compatible = "zmk,behavior-sensor-rotate";
        #sensor-binding-cells = <0>;
        bindings = <&msc SCRL_DOWN>, <&msc SCRL_UP>;

        tap-ms = <100>;
    };

    behaviors {
        hm: hm {
            compatible = "zmk,behavior-hold-tap";
            label = "HM";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <2>;
            bindings = <&kp>, <&kp>;
        };

        // Layer on hold, keycode on tap, for the thumbs. Two departures from
        // ZMK's own &lt: "balanced" so that pressing a key on the layer within
        // the tapping term still gives the layer rather than the tap, and a
        // quick-tap window so tap-then-hold repeats the keycode instead of
        // opening the layer — without it, holding Backspace is impossible.
        tl: thumb_layer {
            compatible = "zmk,behavior-hold-tap";
            label = "TL";
            #binding-cells = <2>;
            flavor = "balanced";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            bindings = <&mo>, <&kp>;
        };
    };

    combos {
        compatible = "zmk,combos";

        softoff {
            bindings = <&soft_off>;
            key-positions = <14 28 40>;
        };
    };

    macros {
        SHIFT_MCLK: SHIFT_MCLK {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_SHIFT>,
                <&macro_press>,
                <&mkp MB3>,
                <&macro_pause_for_release>,
                <&macro_release>,
                <&kp LEFT_SHIFT &mkp MB3>;

            label = "SHIFT_MCLK";
        };

        TRIPLE_DQ: TRIPLE_DQ {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp DQT &kp DQT &kp DQT>;
            label = "TRIPLE_DQ";
        };

        ARROW_L: ARROW_L {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LT &kp MINUS>;
            label = "ARROW_L";
        };

        ARROW_R: ARROW_R {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp MINUS &kp GT>;
            label = "ARROW_R";
        };

        // Unbound dev macros: assign them to keys wherever you like.

        FAT_ARROW: FAT_ARROW {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp EQUAL &kp GT>;
            label = "FAT_ARROW";
        };

        EQ3: EQ3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp EQUAL &kp EQUAL &kp EQUAL>;
            label = "EQ3";
        };

        NEQ3: NEQ3 {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp EXCL &kp EQUAL &kp EQUAL>;
            label = "NEQ3";
        };

        FENCE: FENCE {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp GRAVE &kp GRAVE &kp GRAVE>;
            label = "FENCE";
        };

        TODO_CMT: TODO_CMT {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp SLASH &kp SLASH &kp SPACE &kp LS(T) &kp LS(O) &kp LS(D) &kp LS(O) &kp COLON &kp SPACE>;
            label = "TODO_CMT";
        };

        // console.log(), cursor left inside the parentheses

        LOG: LOG {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp C &kp O &kp N &kp S &kp O &kp L &kp E &kp DOT &kp L &kp O &kp G &kp LPAR &kp RPAR &kp LEFT>;
            label = "LOG";
        };

        GIT_ST: GIT_ST {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp S &kp T &kp A &kp T &kp U &kp S &kp ENTER>;
            label = "GIT_ST";
        };

        GIT_DF: GIT_DF {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp D &kp I &kp F &kp F &kp ENTER>;
            label = "GIT_DF";
        };

        GIT_ADD: GIT_ADD {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp A &kp D &kp D &kp SPACE &kp MINUS &kp LS(A) &kp ENTER>;
            label = "GIT_ADD";
        };

        // git commit -m "" with the cursor between the quotes

        GIT_CM: GIT_CM {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp C &kp O &kp M &kp M &kp I &kp T &kp SPACE &kp MINUS &kp M &kp SPACE &kp DQT &kp DQT &kp LEFT>;
            label = "GIT_CM";
        };

        GIT_PS: GIT_PS {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp P &kp U &kp S &kp H &kp ENTER>;
            label = "GIT_PS";
        };

        GIT_PL: GIT_PL {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp G &kp I &kp T &kp SPACE &kp P &kp U &kp L &kp L &kp ENTER>;
            label = "GIT_PL";
        };

        CD_UP: CD_UP {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp C &kp D &kp SPACE &kp DOT &kp DOT &kp ENTER>;
            label = "CD_UP";
        };

        LS_LA: LS_LA {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <10>;
            tap-ms = <10>;
            bindings = <&kp L &kp S &kp SPACE &kp MINUS &kp L &kp A &kp ENTER>;
            label = "LS_LA";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            bindings = <
&kp ESC                              &kp N1          &kp N2          &kp N3            &kp N4       &kp N5       &kp UP_ARROW     &kp N6     &kp N7       &kp N8             &kp N9           &kp N0              &kp DELETE
&kp TAB                              &kp Q           &kp W           &kp E             &kp R        &kp T        &kp DOWN_ARROW   &kp Y      &kp U        &kp I              &kp O            &kp P               &kp BACKSPACE
&mt LG(LA(LS(LEFT_CONTROL))) ESCAPE  &hm LEFT_GUI A  &hm LEFT_ALT S  &hm LEFT_SHIFT D  &hm LCTRL F  &kp G        &kp LEFT_ARROW   &kp H      &hm RCTRL J  &hm RIGHT_SHIFT K  &hm RIGHT_ALT L  &hm RIGHT_GUI SEMI  &mt LG(LA(LS(LCTRL))) ESCAPE
&kp LSHFT                            &kp Z           &kp X           &kp C             &kp V        &kp B        &kp RIGHT_ARROW  &kp N      &kp M        &kp COMMA          &kp DOT          &kp FSLH            &kp RIGHT_SHIFT
&kp C_MUTE                           &kp LEFT_ALT    &kp LEFT_GUI    &mo 4             &tl 3 ESC    &kp SPACE    &kp ENTER        &kp ENTER  &tl 1 BSPC   &mo 2              &kp RIGHT_GUI    &kp RIGHT_ALT
            >;

            sensor-bindings = <&inc_dec_kp C_VOLUME_UP C_VOL_DN>;
            display-name = "Base";
        };

        Nav {
            bindings = <
&kp GRAVE                 &kp F1        &kp F2        &kp F3        &kp F4        &kp F5          &mmv MOVE_UP     &kp F6     &kp F7    &kp F8      &kp F9         &kp F10        &trans
&trans                    &trans        &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &trans          &mmv MOVE_DOWN   &kp PG_UP  &kp HOME  &kp UP      &kp END        &trans         &trans
&trans                    &trans        &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &trans          &mmv MOVE_LEFT   &kp PG_DN  &kp LEFT  &kp DOWN    &kp RIGHT      &trans         &trans
&trans                    &trans        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp NUMBER_0    &mmv MOVE_RIGHT  &trans     &trans    &kp INSERT  &kp F11        &kp F12        &trans
&kp C_BRIGHTNESS_MAXIMUM  &kp LEFT_ALT  &kp LEFT_GUI  &trans        &trans        &kp SPACE       &mkp LCLK        &kp ENTER  &trans    &trans      &kp RIGHT_GUI  &kp RIGHT_ALT
            >;

            display-name = "Nav";
            sensor-bindings = <&inc_dec_kp C_BRIGHTNESS_INC C_BRIGHTNESS_DEC>;
        };

        System {
            // Nothing on the number row, Corne style — bar the middle
            // column, which a Corne does not have either and which carries
            // the light switches. Left hand drives the pointer, right hand
            // the lighting, thumbs the output. The four keys that cost you
            // something if misfired sit alone in the corners.
            bindings = <
&trans        &trans           &trans           &trans           &trans           &trans             &rgb_ug RGB_TINT  &trans            &trans                 &trans                  &trans                  &trans                  &trans
&bt BT_CLR    &bt BT_SEL 0     &bt BT_SEL 1     &bt BT_SEL 2     &bt BT_SEL 3     &bt BT_SEL 4       &bl BL_TOG   &rgb_ug RGB_TOG        &rgb_ug RGB_EFR        &rgb_ug RGB_EFF         &rgb_ug RGB_HUD         &rgb_ug RGB_HUI         &rgb_ug RGB_COLOR_HSB(160,100,60)
&bt BT_CLR_ALL &mmv MOVE_LEFT  &mmv MOVE_DOWN   &mmv MOVE_UP     &mmv MOVE_RIGHT  &trans             &bl BL_DEC   &rgb_ug RGB_SAD        &rgb_ug RGB_SAI        &rgb_ug RGB_BRD         &rgb_ug RGB_BRI         &rgb_ug RGB_SPD         &rgb_ug RGB_SPI
&sys_reset    &SHIFT_MCLK      &mkp RCLK        &mkp MCLK        &mkp LCLK        &trans             &bl BL_INC   &rgb_ug RGB_EFS_CMD 4  &rgb_ug RGB_EFS_CMD 6  &rgb_ug RGB_EFS_CMD 12  &rgb_ug RGB_EFS_CMD 13  &soft_off               &bootloader
&trans        &out OUT_USB     &out OUT_BLE     &trans           &trans           &kp SPACE          &trans       &kp ENTER              &trans                 &trans                  &trans                  &trans
            >;

            display-name = "System";
            sensor-bindings = <&scroll_encoder>;
        };

        Symbols {
            bindings = <
&trans     &trans        &trans        &trans             &trans      &trans            &trans  &trans                &trans                 &trans          &trans            &trans         &trans
&kp GRAVE  &kp AT        &kp COLON     &kp HASH           &kp DOLLAR  &kp PERCENT       &trans  &kp CARET             &kp AMPERSAND          &trans          &trans            &kp BSLH       &kp DELETE
&trans     &kp EXCL      &kp QUESTION  &kp DOUBLE_QUOTES  &kp SQT     &kp MINUS         &trans  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp LEFT_BRACE  &kp RIGHT_BRACE   &kp PIPE       &kp CAPSLOCK
&trans     &kp TILDE     &kp STAR      &kp EQUAL          &kp PLUS    &kp UNDERSCORE    &trans  &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp LESS_THAN   &kp GREATER_THAN  &kp FSLH       &trans
&trans     &kp LEFT_ALT  &kp LEFT_GUI  &trans             &trans      &kp SPACE         &trans  &kp ENTER             &trans                 &trans          &kp RIGHT_GUI     &kp RIGHT_ALT
            >;

            display-name = "Symbols";
            sensor-bindings = <&inc_dec_kp LG(LS(RBKT)) LG(LS(LBKT))>;
        };

        Macros {
            bindings = <
&trans  &trans      &trans       &trans     &trans  &trans    &trans  &trans   &trans   &trans    &trans   &trans   &trans
&trans  &FENCE      &TRIPLE_DQ   &TODO_CMT  &LOG    &trans    &trans  &trans   &GIT_PL  &GIT_PS   &CD_UP   &LS_LA   &trans
&trans  &FAT_ARROW  &ARROW_R     &EQ3       &NEQ3   &trans    &trans  &trans   &GIT_ST  &GIT_DF   &GIT_ADD &GIT_CM  &trans
&trans  &trans      &trans       &trans     &trans  &trans    &trans  &trans   &trans   &trans    &trans   &trans   &trans
&trans  &trans      &trans       &trans     &trans  &trans    &trans  &trans   &trans   &trans    &trans   &trans
            >;

            display-name = "Macros";
            sensor-bindings = <&inc_dec_kp LG(LS(Z)) LG(Z)>;
        };

    };
};
